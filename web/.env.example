# Where the Next.js server proxies /api/* (server-side only; used by the rewrite in next.config.ts).
API_BASE_URL=http://localhost:8000

# Optional. Leave empty so the browser calls same-origin /api/... through the rewrite.
# Set it only if the browser should call the FastAPI backend directly (the backend then needs CORS).
# It is also used as the rewrite target when API_BASE_URL is unset.
NEXT_PUBLIC_API_BASE_URL=
