# Copy to .env and adjust. Never commit .env. No secret is needed for the default demo.

# PostgreSQL (docker compose sets this for its own services)
DATABASE_URL=postgresql://fdi:change_me_locally@localhost:5432/fdi
POSTGRES_PASSWORD=change_me_locally

# Optional LLM fallback for pages without structured data. Leave empty to run fully deterministic.
ANTHROPIC_API_KEY=

# Fetcher limits
FETCH_TIMEOUT_SECONDS=15
FETCH_MAX_BYTES=3000000
FETCH_MIN_HOST_INTERVAL_SECONDS=1
# Local demo only: host:port pairs that skip the private-address check (./run.sh demo-pages serves
# synthetic pages on 127.0.0.1:8090). Leave empty on any shared or public deployment.
FETCH_DEV_ALLOW_HOSTS=

# API
RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BYTES=65536
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Web (Next.js): where the server-side /api rewrite sends requests
API_BASE_URL=http://localhost:8000
